# Optional: legacy LLM enrichment only (`uv sync --extra llm`).
#
# Core analysis, CLI queries, and the MCP server never read these variables and
# never call a model. They apply only to programmatic use of
# `Orchestrator(enable_llm=True)`. Export them in your shell or load this file
# yourself; the CLI does not read `.env`. Enabling enrichment sends source
# excerpts to the configured provider.

# Providers (first configured wins)
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# OPENROUTER_API_KEY=
# OLLAMA_BASE_URL=http://localhost:11434

# Model tiers: fast for bulk purpose extraction, strong for synthesis.
# LLM_MODEL_FAST=
# LLM_MODEL_STRONG=
# LLM_MODEL=            # overrides both tiers

# Limits
# SEMANTICIST_MAX_MODULES=60
# SEMANTICIST_MAX_SECONDS=900
# SEMANTICIST_MAX_CONSECUTIVE_FAILURES=5
